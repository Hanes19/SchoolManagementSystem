<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_admin_bg">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/bck_btn"
            app:tint="#1B254B"
            tools:ignore="ContentDescription"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Student"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1B254B"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/btn_register"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/LabelText"
                    android:text="Full Name"/>
                <EditText
                    android:id="@+id/et_student_name"
                    style="@style/InputBox"
                    android:hint="e.g. John Doe"
                    android:inputType="textPersonName"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp">
                    <TextView
                        style="@style/LabelText"
                        android:layout_weight="1"
                        android:text="ID Number"/>
                    <TextView
                        android:id="@+id/btn_generate_student_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-Generate"
                        android:textColor="#4318FF"
                        android:textStyle="bold"
                        android:textSize="12sp"/>
                </LinearLayout>
                <EditText
                    android:id="@+id/et_student_id"
                    style="@style/InputBox"
                    android:hint="Click Auto-Generate"/>

                <TextView
                    style="@style/LabelText"
                    android:layout_marginTop="16dp"
                    android:text="Year / Class"/>
                <EditText
                    android:id="@+id/et_student_year"
                    style="@style/InputBox"
                    android:hint="e.g. Grade 10"/>

                <TextView
                    style="@style/LabelText"
                    android:layout_marginTop="16dp"
                    android:text="Email Address"/>
                <EditText
                    android:id="@+id/et_student_email"
                    style="@style/InputBox"
                    android:inputType="textEmailAddress"
                    android:hint="e.g. name@school.edu"/>

                <TextView
                    style="@style/LabelText"
                    android:layout_marginTop="16dp"
                    android:text="Previous School"/>
                <EditText
                    android:id="@+id/et_prev_school"
                    style="@style/InputBox"
                    android:hint="e.g. St. Mary's High"/>

                <TextView
                    style="@style/LabelText"
                    android:layout_marginTop="16dp"
                    android:text="Transfer Cert. No"/>
                <EditText
                    android:id="@+id/et_transfer_cert"
                    style="@style/InputBox"
                    android:hint="e.g. TC-2024-889"/>

                <TextView
                    style="@style/LabelText"
                    android:layout_marginTop="16dp"
                    android:text="Emergency Contact (Name - Phone)"/>
                <EditText
                    android:id="@+id/et_emergency_contact"
                    style="@style/InputBox"
                    android:hint="e.g. Sarah Doe - 555-0199"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="20dp"/>

            </LinearLayout>
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/btn_register"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:cardCornerRadius="30dp"
        app:cardBackgroundColor="#111C44"
        app:cardElevation="6dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Register Student"
            android:textColor="#FFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>