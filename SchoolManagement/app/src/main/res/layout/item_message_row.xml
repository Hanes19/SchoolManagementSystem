<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp">
        <ImageView
            android:id="@+id/img_sender"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/teacher"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription"/>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <TextView
            android:id="@+id/tv_sender_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Mr. Walter White"
            android:textStyle="bold"
            android:textColor="#1B254B"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tv_message_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Chemistry Teacher"
            android:textColor="#1B254B"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tv_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="10:30 AM"
            android:textColor="#A3AED0"
            android:textSize="10sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_action_email"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_dialog_email"
            app:tint="#4318FF"
            android:background="@drawable/rounded_corner_white_bg"
            android:backgroundTint="#F4F7FE"
            android:padding="10dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"/>

        <ImageView
            android:id="@+id/btn_action_call"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_menu_call"
            app:tint="#05CD99"
            android:background="@drawable/rounded_corner_white_bg"
            android:backgroundTint="#E6FFF5"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>
</LinearLayout>