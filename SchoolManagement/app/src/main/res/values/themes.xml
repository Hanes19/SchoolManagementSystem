<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SchoolManagementSystem" parent="Theme.MaterialComponents.DayNight.NoActionBar">
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>
    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="LabelText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#1B254B</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="InputBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/rounded_corner_input_bg</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textColor">#1B254B</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>